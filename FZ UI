local keywords = {}
local builtins = {}

do
    local response = httpGet(KEYWORDS_URL)
    if response then
        local fn = loadstring(response)
        if fn then
            local ok, data = pcall(fn)
            if ok and type(data) == "table" then
                keywords = data.keywords or {}
                builtins = data.builtins or {}
            end
        end
    end
end

