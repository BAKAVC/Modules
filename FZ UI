local function setOverlayLocked(overlay, shouldLock)
    if shouldLock then
        overlay.Visible = true
        tween(overlay, {BackgroundTransparency = 0.4})
    else
        tween(overlay, {BackgroundTransparency = 1})
        task.delay(0.35, function()
            if overlay.BackgroundTransparency > 0.95 then
                overlay.Visible = false
            end
        end)
    end
end

local function updateTabLocks()
