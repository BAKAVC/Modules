            freezeBtn.TextColor3 = isFrozen and Color3.fromRGB(255, 140, 140) or Color3.fromRGB(190, 190, 210)
        end
    end

    local function toggleFreeze()
        if not Connected or not _G_backdoor or not _G_fireRemote then return end

        isFrozen = not isFrozen
        freezeStates[player.UserId] = isFrozen

        local safeName = player.Name:gsub('"', '\\"')

        if isFrozen then
            pcall(_G.fireRemote, _G.backdoor,
                'local p = game.Players["'..safeName..'"]; if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then p.Character.HumanoidRootPart.Anchored = true end')
        else
            pcall(_G.fireRemote, _G.backdoor,
                'local p = game.Players["'..safeName..'"]; if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then p.Character.HumanoidRootPart.Anchored = false; if p.Character:FindFirstChild("Humanoid") then p.Character.Humanoid.WalkSpeed = 16; p.Character.Humanoid.JumpPower = 50 end end')
        end

        updateFreezeButton()
    end

    local function addActionButton(text, callback, baseColor)
        local btn = Instance.new("TextButton", buttonsSection)
        btn.Size = UDim2.new(0, 84, 0, 34)
        btn.BackgroundTransparency = 1
        btn.BorderSizePixel = 1
        btn.BorderColor3 = Color3.fromRGB(75, 75, 90)
        btn.Text = text
        btn.Font = Enum.Font.GothamSemibold
        btn.TextSize = 13
        btn.TextColor3 = baseColor or Color3.fromRGB(190, 190, 210)
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

        local origSize = btn.Size
        local origColor = btn.TextColor3

        btn.MouseEnter:Connect(function()
            tween(btn, {Size = UDim2.new(origSize.X.Scale, origSize.X.Offset + 4, origSize.Y.Scale, origSize.Y.Offset + 4)})
            tween(btn, {TextColor3 = Color3.fromRGB(245, 245, 255)})
        end)

        btn.MouseLeave:Connect(function()
            tween(btn, {Size = origSize})
            tween(btn, {TextColor3 = origColor})
        end)

        btn.MouseButton1Down:Connect(function()
            tween(btn, {Size = UDim2.new(origSize.X.Scale, origSize.X.Offset + 8, origSize.Y.Scale, origSize.Y.Offset + 8)})
        end)

        btn.MouseButton1Up:Connect(function()
            tween(btn, {Size = UDim2.new(origSize.X.Scale, origSize.X.Offset + 4, origSize.Y.Scale, origSize.Y.Offset + 4)})
        end)

        btn.MouseButton1Click:Connect(callback)
    end

    addActionButton("Kick", function()
        if Connected and _G.backdoor and _G.fireRemote then
            local safeName = player.Name:gsub('"', '\\"')
            pcall(_G.fireRemote, _G.backdoor, 'game.Players["'..safeName..'"]:Kick("Kicked via FZ")')
        end
    end)

    addActionButton("Ban", function()
        if Connected and _G.backdoor and _G.fireRemote then
            local safeName = player.Name:gsub('"', '\\"')
            pcall(_G.fireRemote, _G.backdoor, 'game.Players["'..safeName..'"]:Kick("Banned - Permanent")')
        end
    end, Color3.fromRGB(220, 80, 80))

    addActionButton("Freeze", toggleFreeze)
    for _, btn in ipairs(buttonsSection:GetChildren()) do
        if btn:IsA("TextButton") and (btn.Text == "Freeze" or btn.Text == "Unfreeze") then
            freezeBtn = btn
            updateFreezeButton()
            break
        end
    end

    entry.Parent = playerListFrame
    return entry
end

local function updatePlayerList()
    for _, e in ipairs(playerEntries) do
        if e and e.Parent then e:Destroy() end
    end
    playerEntries = {}

    for _, plr in ipairs(Players:GetPlayers()) do
        table.insert(playerEntries, createPlayerEntry(plr))
    end

    task.defer(function()
        playerListFrame.CanvasSize = UDim2.new(0, 0, 0, playerLayout.AbsoluteContentSize.Y + 20)
    end)
end

