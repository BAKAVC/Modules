local function makeButton(parent, icon, tabName, active)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(0, 42, 0, 42)
    b.BackgroundTransparency = 1
    b.Text = ""
    b.AutoButtonColor = false

    local img = Instance.new("ImageLabel", b)
    img.Image = "rbxassetid://" .. icon
    img.Size = active and UDim2.new(1, -6, 1, -6) or UDim2.new(1, -10, 1, -10)
    img.Position = UDim2.new(0.5, 0, 0.5, 0)
    img.AnchorPoint = Vector2.new(0.5, 0.5)
    img.BackgroundTransparency = 1
    img.ImageColor3 = active and Color3.fromRGB(235, 235, 255) or Color3.fromRGB(150, 150, 165)
    img.ImageTransparency = active and 0 or 0.25

    b.MouseButton1Click:Connect(function()
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("TextButton") then
                local childImg = child:FindFirstChildWhichIsA("ImageLabel")
                if childImg then
                    tween(childImg, {Size = UDim2.new(1, -10, 1, -10), ImageTransparency = 0.25, ImageColor3 = Color3.fromRGB(150, 150, 165)})
                end
            end
