local Syntax = {
    Text = Color3.fromRGB(204,204,204),
    Number = Color3.fromRGB(255,198,0),
    String = Color3.fromRGB(173,241,149),
    Comment = Color3.fromRGB(102,102,102),
    Keyword = Color3.fromRGB(248,109,124),
    BuiltIn = Color3.fromRGB(132,214,247),
    FunctionName = Color3.fromRGB(253,251,172),
}

local function colorToHex(c)
    return string.format("#%02X%02X%02X", math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255))
end

local function getTokenType(tokens, idx)
    local val, typ = tokens[idx][1], tokens[idx][2]
    if typ == "Comment" then return "Comment" end
    if typ == "String" then return "String" end
    if typ == "Number" then return "Number" end
    if typ == "Word" then
        if keywords[val] then return "Keyword" end
        if builtins[val] then return "BuiltIn" end
    end
    return "Text"
end

local function tokenize(line)
    local tokens = {}
    local i = 1
    while i <= #line do
        local c = line:sub(i,i)
        if c == "-" and line:sub(i+1,i+1) == "-" then
            table.insert(tokens, {line:sub(i), "Comment"})
            break
        elseif c == '"' or c == "'" then
            local quote, start = c, i
            i = i + 1
            while i <= #line and not (line:sub(i,i) == quote and line:sub(i-1,i-1) ~= "\\") do i = i + 1 end
            table.insert(tokens, {line:sub(start, i), "String"})
        elseif c:match("%d") or (c == "." and line:sub(i+1,i+1):match("%d")) then
            local start = i
            while i <= #line and line:sub(i,i):match("[%d%.eE]") do i = i + 1 end
            table.insert(tokens, {line:sub(start, i-1), "Number"})
            i = i - 1
        elseif c:match("[%a_]") then
            local start = i
            while i <= #line and line:sub(i,i):match("[%w_]") do i = i + 1 end
            table.insert(tokens, {line:sub(start, i-1), "Word"})
            i = i - 1
        else
            table.insert(tokens, {c, "Operator"})
        end
        i = i + 1
    end
    return tokens
end

local function highlightLine(line)
    local tokens = tokenize(line)
    local result = ""
    for i, token in ipairs(tokens) do
        local ttype = getTokenType(tokens, i)
        local color = Syntax[ttype] or Syntax.Text
        local escaped = token[1]:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
        result = result .. string.format('<font color="%s">%s</font>', colorToHex(color), escaped)
    end
    return result
end

