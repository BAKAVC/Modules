local function settingBlock(title, desc, onSlide, minVal, maxVal, init)
    local block = Instance.new("Frame", tabs.Settings.Body)
    block.Size = UDim2.new(1, 0, 0, 90)
    block.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
    Instance.new("UICorner", block).CornerRadius = UDim.new(0, 14)

